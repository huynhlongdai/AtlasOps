{
  "name": "atlasops",
  "version": "0.3.0-alpha.1",
  "description": "Provider-neutral AI infrastructure operations gateway over MCP",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {"node": ">=22"},
  "bin": {"atlasops-operator": "dist/src/operator.js"},
  "scripts": {
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "operator": "tsx src/operator.ts",
    "build": "tsc -p tsconfig.json",
    "start:stdio": "node dist/src/stdio.js",
    "start:http": "node dist/src/http.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.1.0",
    "ssh2": "^1.17.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0"
  }
}
