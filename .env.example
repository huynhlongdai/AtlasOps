ATLASOPS_CONFIG=./config/servers.example.yaml
ATLASOPS_AUDIT_FILE=./data/audit.jsonl
ATLASOPS_APPROVALS_FILE=./data/approvals.json
ATLASOPS_DEPLOYMENTS_FILE=./data/deployments.json
ATLASOPS_AGENT_SESSIONS_FILE=./data/agent-sessions.json
ATLASOPS_USERS_FILE=./data/users.json
ATLASOPS_CONTROL_SETTINGS_FILE=./data/control-settings.json
ATLASOPS_CREDENTIALS_FILE=./data/credentials.enc.json
ATLASOPS_HOST=127.0.0.1
ATLASOPS_PORT=8787
ATLASOPS_ALLOWED_HOSTS=localhost,127.0.0.1
ATLASOPS_ALLOWED_ORIGINS=
ATLASOPS_BEARER_TOKEN=replace-with-a-long-random-token
ATLASOPS_COOKIE_SECURE=false

# Required only when the Control Center user store is empty. Change/remove the
# bootstrap password from your runtime environment after the first user is created.
ATLASOPS_BOOTSTRAP_ADMIN_USER=admin
ATLASOPS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password

# Base64-encoded 32-byte key used by vault:<name> encrypted credentials.
# Generate with: openssl rand -base64 32
ATLASOPS_MASTER_KEY=

# Optional HashiCorp Vault adapter for hashicorp:<path>#<field> refs.
VAULT_ADDR=
VAULT_TOKEN=

# First-party agent runtime. Configure any subset of providers.
ATLASOPS_DEFAULT_PROVIDER=openai
ATLASOPS_DEFAULT_MODEL=gpt-5.6
ATLASOPS_MODEL_PRICES_JSON=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1

ATLASOPS_SSH_KEY_DEMO=
ATLASOPS_SSH_PASSPHRASE_DEMO=
