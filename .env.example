ATLASOPS_CONFIG=./config/servers.example.yaml
ATLASOPS_AUDIT_FILE=./data/audit.jsonl
ATLASOPS_APPROVALS_FILE=./data/approvals.json
ATLASOPS_DEPLOYMENTS_FILE=./data/deployments.json
ATLASOPS_AGENT_SESSIONS_FILE=./data/agent-sessions.json
ATLASOPS_HOST=127.0.0.1
ATLASOPS_PORT=8787
ATLASOPS_ALLOWED_HOSTS=localhost,127.0.0.1
ATLASOPS_ALLOWED_ORIGINS=
ATLASOPS_BEARER_TOKEN=replace-with-a-long-random-token

# First-party agent runtime. Configure any subset of providers.
ATLASOPS_DEFAULT_PROVIDER=openai
ATLASOPS_DEFAULT_MODEL=gpt-5.6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1

ATLASOPS_SSH_KEY_DEMO=
ATLASOPS_SSH_PASSPHRASE_DEMO=
